# Database Configuration
DB_URL=postgresql://user:password@host:5432/database?sslmode=require

# JWT Secret - Generate a secure random string (e.g., openssl rand -hex 64)
JWT_SECRET=your-secure-random-secret-here-change-this

# AWS Configuration (for S3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1

# Email/SMTP Configuration
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_DOMAIN=example.com
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=your-email-password

# Application Settings
RACK_ENV=development
POOL_SIZE=5

# Stripe (if using payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-key

# New Relic (for monitoring)
NEW_RELIC_LICENSE_KEY=your-newrelic-key
NEW_RELIC_APP_NAME=your-app-name

# Email for customer sign-in codes ("My quotations"). Without these, email sign-in says it's switched off.
EMAIL_SMTP_PORT=587
EMAIL_FROM=Arashanapalli Traders <noreply@example.com>

# Quotations and PDFs
SITE_URL=https://your-site.vercel.app           # for "track your quotation" links in PDFs
COMPANY_GSTIN=                                  # the shop's GSTIN, printed on PDFs once set
COMPANY_STATE_CODE=36                           # Telangana: CGST + SGST here, IGST for other states
COMPANY_EMAIL=
QUOTE_VALID_DAYS=15                             # default validity of a new quotation
# QUOTE_TERMS="First term\nSecond term"        # replaces the placeholder terms on PDFs (one per line)
